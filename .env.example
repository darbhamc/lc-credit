# Copy to backend/.env and fill in.

# Required for document extraction and conversational amendment.
# Without it the app still runs: manual entry, reference lookup, validation,
# and the local fallback parser all keep working.
ANTHROPIC_API_KEY=

# SQLite by default. Point at Postgres for anything shared:
# DATABASE_URL=postgresql+psycopg://lc:lc@localhost:5432/lc_copilot
DATABASE_URL=

ANTHROPIC_MODEL=claude-sonnet-4-6
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=20
